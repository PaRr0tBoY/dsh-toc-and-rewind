{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": ["src/index.ts", "src/rewind/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
